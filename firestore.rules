rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
           match /users/{userId} {
      allow read, write: if request.auth != null;
       match /sessions/{sessionId} {
       allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      }
      function waIsAdmin() {
  return request.auth != null && (
   
    request.auth.token.get('role', '') in ['superadmin', 'admin'] ||
  
    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
      in ['superadmin', 'admin']
  );
}
       match /contact/{contactId} {
      allow read, write: if request.auth != null;
      }
             match /about/{aboutId} {
      allow read, write: if request.auth != null;
      }
                   match /states/{stateId} {
      allow read, write: if request.auth != null;
      }
                       match /districts/{districtId} {
      allow read, write: if request.auth != null;
      }
                match /cities/{citiesId} {
      allow read, write: if request.auth != null;
      }
        match /castes/{casteId} {
      allow read, write: if request.auth != null;
      }
       match /relations/{relationId} {
      allow read, write: if request.auth != null;
      }
         match /programs/{programId} {
      allow read, write: if request.auth != null;
      }
            match /agents/{agentId} {
      allow read, write: if request.auth != null;
       match /sessions/{sessionId} {
        allow read, write: if request.auth.uid == agentId;
      }
      }
         match /members/{memberId} {
      allow read, write: if request.auth != null;
         match /memberPrograms/{memberProgramId} {
      allow read, write: if request.auth != null;
      }
  match /sessions/{sessionId} {
        allow read, write: if request.auth.uid == memberId;
      }
      }
            match /whatsappChats/{phone} {
  allow read: if waIsAdmin();
  // Client only ever writes unreadCount: 0 when opening a chat
  allow update: if waIsAdmin()
                && request.resource.data.diff(resource.data)
                     .affectedKeys().hasOnly(['unreadCount']);
  allow create, delete: if false;

  match /messages/{messageId} {
    allow read: if waIsAdmin();
    allow write: if false;
  }
}
               match /commissionTransactions/{commissionTransactionId} {
      allow read, write: if request.auth != null;
      }
                match /memberPaymentSummaries/{memberPaymentSummarieId} {
      allow read, write: if request.auth != null;
      }
      
               match /memberJoinFees/{memberJoinFeesId} {
      allow read, write: if request.auth != null;
      }
       match /memberClosingFees/{memberClosingFeesId} {
      allow read, write: if request.auth != null;
      }
      match /paymentGroups/{paymentGroupId} {
      allow read, write: if request.auth != null;
      }
            match /expenses/{expenseId} {
      allow read, write: if request.auth != null;
      }
            match /categories/{categorieId} {
      allow read, write: if request.auth != null;
      }
        match /organizationStats/{organizationStatId} {
      allow read, write: if request.auth != null;
      }
             match /groupClosings/{groupClosingId} {
      allow read, write: if request.auth != null;
      }
                 match /memberClosings/{memberClosingId} {
      allow read, write: if request.auth != null;
      }
       match /closing_payment/{closing_paymentId} {
      allow read, write: if request.auth != null;
      }
                   match /agentAdvancePayments/{agentAdvancePaymentId} {
      allow read, write: if request.auth != null;
      }
      match /appInfo/{appInfoId} {
      // Allow read access for everyone (including unauthenticated users)
      allow read: if true;
      allow write: if request.auth != null;
    }
      match /settings/{docId} {
      // Members need to read payment details in order to pay
      allow read: if request.auth != null;
      // Only admins may change them
      allow write: if waIsAdmin();
    }
      // Registration-number reservations. A number is claimed by CREATING
      // registrationNumbers/{regNo} (members/components/components/firebaseUtils.js).
      // Without this rule the claim is denied and two people adding members at
      // the same moment can be given the same number. Never edited or reused.
      match /registrationNumbers/{regNo} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
      // Trash page — deleted transactions (list, restore, delete permanently)
      match /transactions/{transactionId} {
      allow read, write: if waIsAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
 
    }
  }
}